# Add UTF-8 charset to HTTP header
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType 'text/html; charset=UTF-8' .html
  AddType 'text/html; charset=UTF-8' .php
</IfModule>

# ========================================
# HTTPS PŘESMĚROVÁNÍ
# ========================================
RewriteEngine On

# Přesměrování HTTP na HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Přesměrování NON-WWW na WWW (OPRAVENO!)
RewriteCond %{HTTP_HOST} ^kondicni-cviceni\.eu$ [NC]
RewriteRule ^(.*)$ https://www.kondicni-cviceni.eu/$1 [R=301,L]

# ========================================
# WEDOS VÝCHOZÍ PRAVIDLA
# ========================================

# cele domeny (aliasy)
RewriteCond %{REQUEST_URI} !^domains/
RewriteCond %{REQUEST_URI} !^/domains/
RewriteCond %{HTTP_HOST} ^(www\.)?(.*)$
RewriteCond %{DOCUMENT_ROOT}/domains/%2 -d
RewriteRule (.*) domains/%2/$1 [DPI]

# subdomeny (s nebo bez www na zacatku)
RewriteCond %{REQUEST_URI} !^subdom/
RewriteCond %{REQUEST_URI} !^/subdom/
RewriteCond %{HTTP_HOST} ^(www\.)?(.*)\.([^\.]*)\.([^\.]*)$
RewriteCond %{DOCUMENT_ROOT}/subdom/%2 -d
RewriteRule (.*) subdom/%2/$1 [DPI]

# aliasy - spravne presmerovani pri chybejicim /
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^domains/[^/]+/(.+[^/])$ /$1/ [R]

# subdomeny - spravne presmerovani pri chybejicim /
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^subdom/[^/]+/(.+[^/])$ /$1/ [R]

# ========================================
# CLEAN URLs
# ========================================

# Přesměrovat index.php a index.html na root
RewriteCond %{THE_REQUEST} /index\.(php|html) [NC]
RewriteRule ^index\.(php|html)$ / [R=301,L]

# Přesměrovat URL s .php příponou na verze bez přípony
RewriteCond %{THE_REQUEST} ^GET\ /[^?\s]+\.php [NC]
RewriteCond %{REQUEST_URI} !mailer\.php [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Přesměrovat URL s .html příponou na verze bez přípony
RewriteCond %{THE_REQUEST} ^GET\ /[^?\s]+\.html [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Interně přidat .php příponu (pokud soubor existuje)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]

# Interně přidat .html příponu (pokud .php neexistuje)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# ========================================
# SECURITY & PERFORMANCE (BONUS)
# ========================================

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ========================================
# CUSTOM ERROR PAGES
# ========================================
ErrorDocument 404 /404.html